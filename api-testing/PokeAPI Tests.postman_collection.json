  "item": [
    {
      "name": "Existing Pokemon",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Pokemon name is pikachu\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.name).to.eql(\"pikachu\");",
              "});",
              "",
              "",
              "pm.test(\"Pikachu's ability is static\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.abilities[0].ability.name).to.eql(\"static\");",
              "});"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
